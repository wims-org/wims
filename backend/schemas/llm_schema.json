{
    "name": "item_schema",
    "strict": true,
    "schema": {
      "type": "object",
      "title": "Item",
      "$schema": "http://json-schema.org/draft-07/schema#",
      "version": "0.1.0",
      "required": [
        "short_name",
        "consumable",
        "description",
        "tags",
        "price_new",
        "price_used",
        "manufacturer",
        "model_number",
        "serial_number"
      ],
      "properties": {
        "short_name": {
          "type": "string",
          "description": "Short name of the item"
        },
        "consumable": {
          "type": "boolean",
          "description": "Indicates if the item is consumable"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "Concise description of the item and general use"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Custom tags for categorization"
        },
        "price_new": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Price per item in cents when bought new"
        },
        "price_used": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Price per item in cents, for e.g. selling"
        },
        "manufacturer": {
          "type": [
            "string",
            "null"
          ],
          "description": "Manufacturer of the item"
        },
        "model_number": {
          "type": [
            "string",
            "null"
          ],
          "description": "Model number of the item"
        },
        "serial_number": {
          "type": [
            "string",
            "null"
          ],
          "description": "Serial number of the item"
        }
      },
      "description": "Schema for an item",
      "additionalProperties": false
    }
  }